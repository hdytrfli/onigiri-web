---
import { ArrowUpRight } from "@lucide/astro";

const year = new Date().getFullYear();

type FooterLink = { label: string; href: string; external?: boolean };
type FooterColumn = { title: string; links: FooterLink[] };

const columns: FooterColumn[] = [
  {
    title: "Product",
    links: [
      { label: "Onboarding", href: "#onboarding" },
      { label: "Movies", href: "#movies" },
      { label: "Shows", href: "#shows" },
      { label: "Books", href: "#books" },
      { label: "Songs", href: "#songs" },
      { label: "Settings", href: "#settings" },
      { label: "Download", href: "#download" },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: "https://github.com/hdytrfli/onigiri-client", external: true },
      { label: "Releases", href: "https://github.com/hdytrfli/onigiri-client/releases", external: true },
      { label: "Issues", href: "https://github.com/hdytrfli/onigiri-client/issues", external: true },
    ],
  },
  {
    title: "Elsewhere",
    links: [
      { label: "Jellyfin", href: "https://jellyfin.org", external: true },
      { label: "GPL-3.0 license", href: "https://github.com/hdytrfli/onigiri-client/blob/main/LICENSE", external: true },
    ],
  },
];
---

<footer class="bg-wash/40">
  <div class="wrap-wide grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5" aria-label="Onigiri home">
        <img src="/logo.svg" alt="" width="33" height="28" class="h-7 w-auto" />
        <span class="font-display text-[22px] leading-none">Onigiri</span>
      </a>
      <p class="mt-4 max-w-[22rem] text-sm leading-relaxed text-muted">
        A native Jellyfin client for Android. Your server, your library, your pace.
      </p>
    </div>

    {columns.map((column) => (
      <div>
        <p class="eyebrow">{column.title}</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {column.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex items-center gap-1 text-muted transition-colors hover:text-ink"
                {...(link.external ? { target: "_blank", rel: "noreferrer" } : {})}
              >
                {link.label}
                {link.external && <ArrowUpRight size={12} aria-hidden="true" />}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="bg-ink/[0.03]">
    <div class="wrap-wide flex flex-col gap-2 py-6 text-[11.5px] text-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Onigiri. Released under GPL-3.0.</p>
      <p>Not affiliated with Jellyfin. Type set in Geist & DM Serif Text.</p>
    </div>
  </div>
</footer>
