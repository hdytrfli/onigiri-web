---
interface Props {
  index?: string;
  eyebrow: string;
  title: string;
  body?: string;
  center?: boolean;
}

const { index, eyebrow, title, body, center = false } = Astro.props;
---

<div class:list={[center && "mx-auto max-w-[36rem] text-center"]}>
  <p class="eyebrow">
    {index && <span class="mr-2 text-ink/35">{index}</span>}
    {eyebrow}
  </p>
  <h2 class="mt-3 font-display text-section leading-[1.06] tracking-[-0.01em]">{title}</h2>
  {body && <p class:list={["mt-4 prose-muted", center && "mx-auto max-w-[32rem]"]}>{body}</p>}
</div>
