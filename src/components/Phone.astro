---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: "eager" | "lazy";
  shadow?: boolean;
}

const {
  src,
  alt,
  class: className,
  sizes = "(max-width: 640px) 46vw, 280px",
  loading = "lazy",
  shadow = true,
} = Astro.props;

const shortEdge = Math.min(1, src.height / src.width).toFixed(3);
---

<div class:list={["phone-shell relative", className]} style={`--phone-min: ${shortEdge}`}>
  <div
    class:list={[
      "phone-frame relative bg-ink",
      shadow && "shadow-[0_40px_90px_-70px_rgba(0,0,0,0.6)]",
    ]}
  >
    <Image
      src={src}
      alt={alt}
      widths={[240, 360, 480, 640, 880]}
      sizes={sizes}
      format="webp"
      loading={loading}
      draggable="false"
      class="phone-screen h-auto w-full"
    />
  </div>
</div>
