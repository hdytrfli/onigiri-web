---
import { Image } from "astro:assets";
import {
  ArrowDownToLine,
  Captions,
  Code,
  Layers,
  LayoutGrid,
  MessageCircle,
  Package,
  Play,
  Scale,
  Search,
  Server,
  ShieldCheck,
  SkipBack,
  SkipForward,
  WifiOff,
} from "@lucide/astro";

import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Phone from "../components/Phone.astro";
import Gallery from "../components/Gallery.astro";
import Faq from "../components/Faq.astro";
import FeatureList from "../components/FeatureList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Speech from "../components/Speech.astro";
import { FALLBACK_VERSION, fetchLatestVersion } from "../lib/release";

import idle from "../../mascot/idle.png";
import excited from "../../mascot/excited.png";
import questioning from "../../mascot/questioning.png";

import home from "../assets/screens/home.jpg";
import movie from "../assets/screens/movie.jpg";
import movieList from "../assets/screens/movie-list.jpg";
import episodes from "../assets/screens/episodes.jpg";
import reader from "../assets/screens/reader.jpg";
import audiobook from "../assets/screens/audiobook.jpg";
import musicPlayer from "../assets/screens/music-player.jpg";
import artists from "../assets/screens/artists.jpg";
import player from "../assets/screens/player.jpg";
import onboardingSignin from "../assets/screens/onboarding-signin.jpg";
import settings from "../assets/screens/settings.jpg";
import subtitleSettings from "../assets/screens/subtitle-settings.jpg";

const repoUrl = "https://github.com/hdytrfli/onigiri-client";
const releaseUrl = `${repoUrl}/releases/latest`;
const issuesUrl = `${repoUrl}/issues`;
const licenseUrl = `${repoUrl}/blob/main/LICENSE`;
const jellyfinUrl = "https://jellyfin.org";
let version = FALLBACK_VERSION;
if (import.meta.env.PROD) {
  version = (await fetchLatestVersion()) ?? version;
}

const strip = [
  { label: "License", value: "GPL-3.0" },
  { label: "Platform", value: "Android 9+" },
  { label: "Server", value: "Jellyfin" },
  { label: "Telemetry", value: "None" },
];

const steps = ["Server URL", "Sign in", "Choose a profile"];

const settingsGroups = [
  "Playback",
  "Subtitles",
  "Reader",
  "Downloads",
  "Profiles",
  "About",
];

const libraryFeatures = [
  {
    icon: WifiOff,
    title: "Offline downloads",
    body: "Movies, episodes, books, and audiobooks, ready without a network.",
  },
  {
    icon: Search,
    title: "Scoped search",
    body: "Search a single library, then sort and filter without leaving it.",
  },
  {
    icon: Captions,
    title: "Subtitle styling",
    body: "SRT and ASS tracks with size, offset, and per-item selection.",
  },
  {
    icon: Layers,
    title: "Collections and genres",
    body: "Suggestions, favorites, and collections from your server.",
  },
  {
    icon: LayoutGrid,
    title: "Adaptive layout",
    body: "Grids, artwork ratios, and density that follow the screen.",
  },
  {
    icon: ShieldCheck,
    title: "Admin aware",
    body: "Admin controls appear only when the account can use them.",
  },
];



const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Onigiri",
  description:
    "A native Android client for Jellyfin with a built-in EPUB reader, a music player, and mpv video playback.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Android 9+",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  url: repoUrl,
  downloadUrl: releaseUrl,
};
---

<Base>
  <Nav />

  <main id="main">
    <section class="relative overflow-hidden pt-14 sm:pt-20">
      <div class="wrap text-center">
        <p class="eyebrow rise">Open source Android client for Jellyfin</p>

        <h1 class="rise mt-5 font-display text-hero leading-[0.98] tracking-[-0.01em]">
          A Jellyfin client<br />for <span class="highlight">Android</span>.
        </h1>

        <p class="rise-late mx-auto mt-6 max-w-[36rem] text-lead leading-relaxed text-muted">
          Onigiri connects to the Jellyfin server you run and plays your movies, shows, books,
          audiobooks, and music. GPL-3.0, with no account, ads, or telemetry.
        </p>

        <div class="rise-late mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={releaseUrl}
            target="_blank"
            rel="noreferrer"
            class="btn btn-solid w-full sm:w-auto"
          >
            <ArrowDownToLine size={16} aria-hidden="true" />
            Download APK
          </a>
          <a
            href={repoUrl}
            target="_blank"
            rel="noreferrer"
            class="btn btn-ghost w-full sm:w-auto"
          >
            <GitHubIcon size={16} />
            Source and issues
          </a>
        </div>

        <p class="rise-late mt-4 text-xs text-faint">
          v<span data-latest-version>{version}</span> · Android 9+ · GPL-3.0
        </p>
      </div>

      <div class="wrap-wide relative mt-12 sm:mt-16">
        <div class="relative mx-auto flex max-w-[34rem] items-end justify-center">
          <div
            class="pointer-events-none absolute bottom-6 left-1/2 h-40 w-[70%] -translate-x-1/2 rounded-[100%] bg-wash blur-2xl"
            aria-hidden="true"
          >
          </div>
          <Image
            src={idle}
            alt=""
            width={560}
            format="webp"
            class="mascot-float relative z-10 -mr-6 mb-8 w-32 sm:-mr-10 sm:w-56"
            aria-hidden="true"
          />
          <Phone
            src={home}
            alt="The Onigiri home screen, showing suggestions and recently added movies"
            class="relative z-20 w-[205px] sm:w-[268px]"
            sizes="(max-width: 640px) 56vw, 268px"
            loading="eager"
          />
        </div>
      </div>
    </section>
    <section class="mt-16 sm:mt-24">
      <div class="wrap">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 rounded-[1.75rem] bg-wash p-6 sm:grid-cols-4 sm:p-7">
          {strip.map((item) => (
            <div>
              <dt class="text-[9.5px] font-medium uppercase tracking-[0.2em] text-faint">
                {item.label}
              </dt>
              <dd class="mt-1.5 text-[13.5px] font-medium">{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
    <section id="onboarding" class="scroll-mt-24 py-20 sm:py-28">
      <div class="wrap-wide grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <SectionHeading
            index="01"
            eyebrow="Onboarding"
            title="Connecting to a server."
            body="Onigiri needs the URL of a Jellyfin server and an account. Sign in with a password or Quick Connect. The session is saved, so the profile picker opens on the next launch."
          />
          <p class="mt-4 prose-muted">
            Profiles are local. A four-digit PIN can lock one, and switching profiles clears
            artwork and reader state but keeps downloads.
          </p>

          <ol class="mt-7 grid gap-2 sm:grid-cols-3">
            {steps.map((step, index) => (
              <li class="rounded-2xl bg-wash p-4">
                <span class="font-display text-[12px] text-faint">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="mt-1 text-[13.5px] font-medium leading-snug">{step}</p>
              </li>
            ))}
          </ol>

          <FeatureList
            items={[
              "Password or Quick Connect",
              "Saved session and profile picker",
              "Optional four-digit PIN",
              "Admin controls when available",
            ]}
          />
        </div>

        <div class="relative flex justify-center lg:justify-end">
          <Phone
            src={onboardingSignin}
            alt="Signing in to a Jellyfin server"
            class="w-[250px] rotate-2 sm:w-[300px]"
            sizes="(max-width: 640px) 62vw, 300px"
          />
          <Image
            src={questioning}
            alt=""
            width={360}
            format="webp"
            class="absolute -bottom-8 -left-4 w-32 sm:w-40"
            aria-hidden="true"
          />
        </div>
      </div>
    </section>
    <section id="movies" class="scroll-mt-24 bg-wash py-20 sm:py-28">
      <div class="wrap text-center">
        <SectionHeading
          center
          index="02"
          eyebrow="Movies"
          title="Movies."
          body="The movie library shows suggestions, genres, collections, and the full list from Jellyfin. A detail page keeps artwork, cast, versions, and the play and download actions together."
        />
        <p class="mx-auto mt-4 max-w-[42rem] prose-muted">
          Sorting and display options are per list. Search can be limited to the movie library.
        </p>
      </div>

      <div class="wrap-wide mt-12">
        <div class="flex items-center justify-center">
          <Phone
            src={movieList}
            alt="The movie list in Onigiri"
            class="w-[180px] -rotate-6 sm:w-[230px]"
            sizes="(max-width: 640px) 48vw, 230px"
          />
          <Phone
            src={movie}
            alt="A movie detail page"
            class="z-10 -ml-8 w-[220px] rotate-3 sm:-ml-10 sm:w-[300px]"
            sizes="(max-width: 640px) 58vw, 300px"
          />
        </div>

        <FeatureList
          class="mx-auto mt-10 max-w-[40rem]"
          items={[
            "Suggestions, genres, and collections",
            "Artwork, cast, and versions",
            "Scoped search and sorting",
            "Download for offline playback",
          ]}
        />
      </div>
    </section>
    <section id="shows" class="scroll-mt-24 py-20 sm:py-28">
      <div class="wrap">
        <SectionHeading
          index="03"
          eyebrow="Shows"
          title="Shows and episodes."
          body="Shows are grouped by season, with episode detail pages and a next-up entry based on your watch position. Playback resumes where it stopped."
        />
        <p class="mt-4 prose-muted">
          Video uses mpv with bundled FFmpeg codecs. Subtitles can be SRT or ASS, with per-item
          offset and styling.
        </p>
      </div>

      <div class="wrap-wide mt-10">
        <div
          class="flex flex-col items-center gap-4 lg:flex-row lg:items-end lg:justify-center lg:gap-8"
        >
          <Phone
            src={episodes}
            alt="The episode list for a season in Onigiri"
            class="w-[55%] max-w-[230px] lg:w-[210px]"
            sizes="(max-width: 640px) 55vw, 210px"
          />
          <Phone
            src={player}
            alt="Video playback in Onigiri"
            class="w-full max-w-[520px] lg:w-[500px]"
            sizes="(max-width: 640px) 90vw, 500px"
          />
        </div>

        <FeatureList
          class="mx-auto mt-9 max-w-[46rem]"
          items={[
            "Season and episode detail",
            "Next-up and progress",
            "Trickplay thumbnails and chapters",
            "Subtitle styling and per-item offset",
          ]}
        />
      </div>
    </section>
    <section id="books" class="scroll-mt-24 bg-wash py-20 sm:py-28">
      <div class="wrap-wide grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
        <div
          class="order-2 flex items-end justify-center lg:order-1 lg:justify-start"
        >
          <Phone
            src={reader}
            alt="Reading an EPUB in Onigiri"
            class="w-[220px] -rotate-3 sm:w-[290px]"
            sizes="(max-width: 640px) 56vw, 290px"
          />
          <Phone
            src={audiobook}
            alt="An audiobook playing in Onigiri"
            class="relative z-10 -ml-14 mb-2 w-[140px] rotate-6 sm:-ml-20 sm:w-[190px]"
            sizes="(max-width: 640px) 36vw, 190px"
          />
        </div>

        <div class="order-1 lg:order-2">
          <SectionHeading
            index="04"
            eyebrow="Books and audiobooks"
            title="Books and audiobooks."
            body="The Books tab lists EPUBs and audiobooks from Jellyfin. EPUBs open in an in-app reader with themes, fonts, hyphenation, line width, and a table of contents. Position is stored per book."
          />
          <p class="mt-4 prose-muted">
            Audiobooks have a separate player with speed control and a queue. Both formats can be
            downloaded.
          </p>

          <FeatureList
            items={[
              "Reader themes and typography",
              "Table of contents and position",
              "Audiobook speed and queue",
              "Offline downloads for both",
            ]}
          />

          <div class="mt-7 rounded-2xl bg-paper p-4">
            <p class="font-display text-lg leading-snug">Chapter 12, 64%</p>
            <p class="mt-1 text-xs text-faint">Reading position, saved per book</p>
          </div>
        </div>
      </div>
    </section>
    <section id="songs" class="scroll-mt-24 py-20 sm:py-28">
      <div class="wrap text-center">
        <SectionHeading
          center
          index="05"
          eyebrow="Songs"
          title="Music."
          body="The Music tab lists artists, albums, songs, and favorites. The queue can be reordered and searched, and playback continues in the background with a mini-player."
        />
        <p class="mx-auto mt-4 max-w-[42rem] prose-muted">
          Shuffle and repeat modes include repeat-one. Artwork can be a cover or a spinning
          record.
        </p>
      </div>

      <div class="wrap-wide mt-12">
        <div class="flex items-end justify-center gap-3 sm:gap-6">
          <Phone
            src={artists}
            alt="Artists page with the audio mini-player"
            class="w-[42%] -rotate-3 sm:w-[240px]"
            sizes="(max-width: 640px) 42vw, 240px"
          />
          <Phone
            src={musicPlayer}
            alt="The Onigiri music player with vinyl artwork"
            class="w-[58%] rotate-2 sm:w-[320px]"
            sizes="(max-width: 640px) 58vw, 320px"
          />
        </div>

        <div
          class="mx-auto mt-8 flex max-w-[36rem] items-center gap-3 rounded-2xl bg-ink px-4 py-3 text-paper"
        >
          <div class="size-9 shrink-0 rounded-lg bg-paper/15" aria-hidden="true"></div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-[13px] font-medium">Track title</p>
            <p class="text-[11px] text-paper/55">Artist</p>
          </div>
          <div class="flex items-center gap-4 text-paper/80" aria-hidden="true">
            <SkipBack size={15} />
            <Play size={15} />
            <SkipForward size={15} />
          </div>
        </div>

        <FeatureList
          class="mx-auto mt-9 max-w-[42rem]"
          items={[
            "Artists, albums, and songs",
            "Reorderable queue with search",
            "Shuffle, repeat, repeat-one",
            "Background playback and mini-player",
          ]}
        />
      </div>
    </section>
    <section id="settings" class="scroll-mt-24 bg-wash py-20 sm:py-28">
      <div class="wrap-wide grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <SectionHeading
            index="06"
            eyebrow="Settings"
            title="Settings."
            body="Settings cover playback, subtitles, reader typography, download storage, profiles, and app information. Each group is a single list."
          />
          <p class="mt-4 prose-muted">
            Playback speed, seek mode, subtitle size and offset, reader theme and line width, and
            the download folder are configurable.
          </p>

          <ul class="mt-7 grid gap-2 sm:grid-cols-2">
            {settingsGroups.map((group) => (
              <li class="rounded-xl bg-paper px-4 py-3 text-[13px] font-medium">{group}</li>
            ))}
          </ul>
        </div>

        <div class="flex items-end justify-center lg:justify-end">
          <Phone
            src={settings}
            alt="The settings page in Onigiri"
            class="w-[220px] rotate-1 sm:w-[290px]"
            sizes="(max-width: 640px) 56vw, 290px"
          />
          <Phone
            src={subtitleSettings}
            alt="Subtitle settings"
            class="relative z-10 -ml-14 mb-2 w-[140px] -rotate-6 sm:-ml-20 sm:w-[190px]"
            sizes="(max-width: 640px) 36vw, 190px"
          />
        </div>
      </div>
    </section>
    <section id="library" class="scroll-mt-24 py-20 sm:py-28">
      <div class="wrap-wide">
        <SectionHeading
          eyebrow="Also in the box"
          title="Other parts of the app."
          body="Smaller features that do not need their own section."
        />

        <div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {libraryFeatures.map(({ icon: Icon, title, body }) => (
            <div class="card p-5">
              <Icon size={18} class="text-ink" aria-hidden="true" />
              <h3 class="mt-4 text-[14.5px] font-medium">{title}</h3>
              <p class="mt-1.5 text-[13.5px] leading-relaxed text-muted">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section id="open" class="scroll-mt-24 pb-20 sm:pb-28">
      <div class="wrap-wide">
        <div class="rounded-[2rem] bg-wash p-6 sm:p-10">
          <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-12">
            <div>
              <p class="eyebrow">Open source</p>
              <h2 class="mt-3 font-display text-section leading-[1.06]">Source and issues.</h2>
              <p class="mt-4 prose-muted">
                The client is GPL-3.0. The repository contains the Android app and the issue
                tracker. Jellyfin is a separate project and is not affiliated with Onigiri.
              </p>
              <p class="mt-3 prose-muted">
                Builds are published on GitHub Releases. There is no account system, analytics,
                or crash reporting service.
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                <a
                  href={repoUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-solid btn-sm"
                >
                  <Code size={14} aria-hidden="true" />
                  GitHub
                </a>
                <a
                  href={issuesUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-ghost btn-sm"
                >
                  <MessageCircle size={14} aria-hidden="true" />
                  Issues
                </a>
                <a
                  href={licenseUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-ghost btn-sm"
                >
                  <Scale size={14} aria-hidden="true" />
                  GPL-3.0
                </a>
                <a
                  href={jellyfinUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-ghost btn-sm"
                >
                  <Server size={14} aria-hidden="true" />
                  Jellyfin
                </a>
              </div>
            </div>

            <Speech src={idle} text="hello, server." class="lg:justify-end" />
          </div>
        </div>
      </div>
    </section>

    <Gallery />
    <section id="download" class="scroll-mt-24 bg-wash py-20 sm:py-28">
      <div class="wrap text-center">
        <Image
          src={excited}
          alt=""
          width={640}
          format="webp"
          class="mascot-float mx-auto w-36 sm:w-44"
          aria-hidden="true"
        />

        <h2 class="mt-6 font-display text-section leading-[1.06]">Download.</h2>
        <p class="mx-auto mt-4 max-w-[34rem] prose-muted">
          The current beta is distributed as an APK on GitHub Releases. Google Play and F-Droid
          are not available yet. Build instructions are in the repository.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={releaseUrl}
            target="_blank"
            rel="noreferrer"
            class="btn btn-solid w-full sm:w-auto"
          >
            <ArrowDownToLine size={16} aria-hidden="true" />
            Download the APK
          </a>
          <a
            href={repoUrl}
            target="_blank"
            rel="noreferrer"
            class="btn btn-ghost w-full sm:w-auto"
          >
            <GitHubIcon size={16} />
            Source
          </a>
        </div>

        <div class="mt-10 grid gap-3 text-left sm:grid-cols-3">
          <a
            href={releaseUrl}
            target="_blank"
            rel="noreferrer"
            class="card bg-paper p-5 transition-shadow hover:shadow-[0_18px_40px_-32px_rgba(0,0,0,0.35)]"
          >
            <GitHubIcon size={18} />
            <p class="mt-4 text-sm font-medium">GitHub Releases</p>
            <p class="mt-1 text-xs text-muted">
              Available now · v<span data-latest-version>{version}</span>
            </p>
          </a>

          <div class="card bg-paper p-5">
            <Play size={18} class="text-ink/45" aria-hidden="true" />
            <p class="mt-4 text-sm font-medium text-ink/60">Google Play</p>
            <p class="mt-1 text-xs text-muted">Not available yet</p>
          </div>

          <div class="card bg-paper p-5">
            <Package size={18} class="text-ink/45" aria-hidden="true" />
            <p class="mt-4 text-sm font-medium text-ink/60">F-Droid</p>
            <p class="mt-1 text-xs text-muted">Not available yet</p>
          </div>
        </div>

        <p class="mt-6 text-xs text-faint">APK · Android 9+ · Requires a Jellyfin server</p>
      </div>
    </section>

    <Faq />
  </main>

  <Footer />

  <script>
    const nodes = document.querySelectorAll<HTMLElement>("[data-latest-version]");

    fetch("/api/version")
      .then((response) =>
        response.ok ? response.json() : Promise.reject(new Error(String(response.status))),
      )
      .then((data: { version?: string | null }) => {
        const version = data.version;
        if (!version) return;

        nodes.forEach((node) => {
          node.textContent = version;
        });
      })
      .catch(() => {});
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</Base>
